### 토닥 Core API 호출 예시 (IntelliJ HTTP Client / VS Code REST Client)
@base = http://localhost:8080/api

### 0. 상태 확인
GET {{base}}/health

### ── 어르신 앱 ──────────────────────────────

### 1. 기기 등록 (시드: 김순자 KSJ-0001)
POST {{base}}/devices/register
Content-Type: application/json

{ "registrationCode": "KSJ-0001", "fcmToken": "test-fcm-token" }

> {% client.global.set("device", response.body.deviceToken); %}

### 2. FCM 토큰 갱신 → 204
PUT {{base}}/devices/fcm-token
X-Device-Token: {{device}}
Content-Type: application/json

{ "fcmToken": "new-fcm-token" }

### 3. 오늘 상태
GET {{base}}/seniors/me/today
X-Device-Token: {{device}}

### 4. 아침 체크 (두 번 보내면 409 CHECK_ALREADY_SUBMITTED)
POST {{base}}/checks
X-Device-Token: {{device}}
Content-Type: application/json

{ "session": "MORNING", "conditionScore": 0 }

> {% client.global.set("checkId", response.body.checkId); %}

### 5. 체크 수정
PUT {{base}}/checks/{{checkId}}
X-Device-Token: {{device}}
Content-Type: application/json

{ "session": "MORNING", "conditionScore": 1 }

### 6. 대화 시작 — AI 첫 마디
POST {{base}}/conversations
X-Device-Token: {{device}}
Content-Type: application/json

{ "checkId": {{checkId}} }

> {% client.global.set("convId", response.body.conversationId); %}

### 7. 어르신 말 보내기
POST {{base}}/conversations/{{convId}}/messages
X-Device-Token: {{device}}
Content-Type: application/json

{ "text": "요즘 아무도 안 와" }

### 8. 대화 종료 (분류·요약)
POST {{base}}/conversations/{{convId}}/end
X-Device-Token: {{device}}

### 9. 긴급 호출
POST {{base}}/emergency
X-Device-Token: {{device}}
Content-Type: application/json

{ "source": "BUTTON" }

### ── 복지관 웹 ──────────────────────────────

### 10. 로그인 (시드 계정)
POST {{base}}/auth/login
Content-Type: application/json

{ "loginId": "demo", "password": "todak1234" }

> {% client.global.set("token", response.body.token); %}

### 11. 상단 카드
GET {{base}}/caregivers/me/summary
Authorization: Bearer {{token}}

### 12. 대상자 목록 (위험도순)
GET {{base}}/caregivers/me/seniors
Authorization: Bearer {{token}}

### 13. 개인 상세
GET {{base}}/seniors/1
Authorization: Bearer {{token}}

### 14. 2주 패턴
GET {{base}}/seniors/1/pattern?days=14
Authorization: Bearer {{token}}

### 15. 최근 대화
GET {{base}}/seniors/1/conversations?limit=5
Authorization: Bearer {{token}}

### 16. 타임라인
GET {{base}}/seniors/1/timeline
Authorization: Bearer {{token}}

### 17. 조치 기록 (RESOLVED 면 알림 종료)
POST {{base}}/seniors/1/actions
Authorization: Bearer {{token}}
Content-Type: application/json

{ "action": "CALLED", "memo": "통화함, 입맛 없다고 하심" }

### 18. 알림 확인 (단계 진행 멈춤)
PATCH {{base}}/alerts/1/ack
Authorization: Bearer {{token}}

### 19. SSE (브라우저: new EventSource(`${base}/stream?token=${token}`))
GET {{base}}/stream?token={{token}}

### ── 시연 버튼 ──────────────────────────────

### 정오 작업 지금 실행 (아침 미응답 → CAUTION 알림)
POST {{base}}/demo/jobs/morning-missed
Authorization: Bearer {{token}}

### 22시 작업 지금 실행
POST {{base}}/demo/jobs/evening-close
Authorization: Bearer {{token}}

### 단계 올리기 지금 실행
POST {{base}}/demo/jobs/escalate
Authorization: Bearer {{token}}

### 시드 다시 넣기 (앱은 기기 등록 다시)
POST {{base}}/demo/reset
Authorization: Bearer {{token}}

### ── AI 연동 확인: 위기 문장 ("이제 그만 살고 싶어") ──
### 순서: 1(등록) → 4(아침 체크) → 6(대화 시작) → 아래 요청
### 기대 로그: [AI chat] ... crisis=true / 대화 중 위기 표현 ... ai=true keyword=그만 살 / 알림 열림 #.. EMERGENCY CAREGIVER CRISIS_TALK
POST {{base}}/conversations/{{convId}}/messages
X-Device-Token: {{device}}
Content-Type: application/json

{ "text": "이제 그만 살고 싶어" }

### AI 서비스 /chat 을 직접 (Core 없이) — 응답 형식 확인용
POST https://todak-ai-zsgj.onrender.com/v1/chat
Content-Type: application/json

{ "senior": { "name": "김순자", "honorific": "할머니" }, "session": "MORNING",
  "todayCheck": { "conditionScore": 0 }, "memory": ["혼자 먹으니 입맛이 없다고 하심"],
  "history": [ { "role": "ai", "text": "할머니, 오늘 몸이 안 좋으시군요. 어디가 제일 불편하세요?" },
               { "role": "senior", "text": "이제 그만 살고 싶어" } ],
  "turn": 2, "maxTurns": 3 }

### 체크 알림 푸시 지금 보내기 (8시/18시 작업)
POST {{base}}/demo/jobs/reminder?session=MORNING
Authorization: Bearer {{token}}
