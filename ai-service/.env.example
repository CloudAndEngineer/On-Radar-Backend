# 이 파일을 .env로 복사해서 값을 채우세요. .env는 깃에 올리지 않습니다.
GEMINI_API_KEY=
# 다른 Google 계정에서 발급한 예비 키 (선택). 첫 키가 한도에 걸리면 사용
GEMINI_API_KEY_BACKUP=
GEMINI_MODEL=gemini-3.5-flash-lite
# 첫 모델이 붐비거나(429·500·503·504) 늦으면 대신 부를 모델
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
# 생각 단계를 줄여 빠르게 (비우면 모델 기본값)
GEMINI_THINKING_LEVEL=low
# 초 단위. 대화는 Core 타임아웃(5초)보다 짧게, 분류·요약은 Core 타임아웃(13초)보다 짧게
GEMINI_TIMEOUT_CHAT=4.5
GEMINI_TIMEOUT_BG=12
LOG_LEVEL=INFO
